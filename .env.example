# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# HD Wallet (PUBLIC xpubs only — cannot spend)
BTC_XPUB=your_btc_xpub_here
ETH_XPUB=your_eth_xpub_here
# SOL addresses are pre-generated and stored in sol_addresses table

# Blockchain APIs
ALCHEMY_ETH_API_KEY=your_alchemy_eth_key_here
ALCHEMY_SOL_API_KEY=your_alchemy_sol_key_here

# Cron security
CRON_SECRET=your_random_64_char_hex_here

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Email (SMTP) — used for ALL transactional email (order confirmations,
# shipping notifications, invoices, magic links, etc.).
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@aminocan.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_NAME=Aminocan
SMTP_FROM_EMAIL=noreply@aminocan.com

# Email (Resend) — legacy/optional. No longer used for sending; kept for
# reference. EMAIL_FROM is used only as a fallback "From" when SMTP_FROM_EMAIL
# is unset.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Aminocan <orders@aminocan.com>

# PuraMass hosted checkout (Stealth Health partner API)
# Server-side ONLY — never expose these in browser/client code. When the cart
# hands off to the PuraMass hosted checkout, the backend POSTs the cart's SKUs
# to this API and redirects the customer to the returned payment_link on the
# PuraMass patient-portal domain. Toggle the feature on in the admin Settings
# page (site_settings.puramass_checkout_enabled); these vars supply the
# credentials the server uses to call the API. If the key is unset the hosted
# checkout stays disabled regardless of the toggle.
PURAMASS_API_BASE_URL=https://api.stealth.health
PURAMASS_PARTNER_ID=ptr_puramass
PURAMASS_API_KEY=your_puramass_sk_live_key_here
# Secret for verifying incoming PuraMass webhooks (store_order.payment_complete).
# Header: `X-Stealth-Signature: sha256=<hmac-sha256 of the raw request body>`.
# Server-side only. Register the endpoint <base>/api/webhooks/stealth-health with
# PuraMass. If unset, incoming webhooks are rejected.
PURAMASS_WEBHOOK_SECRET=your_puramass_whsec_here
# Master kill-switch for the hosted checkout. The primary control is the config
# file `puramass.config.ts` (PURAMASS_CHECKOUT_ENABLED). Setting this env var to
# `false` also forces it off (takes precedence) without a code change — the
# storefront then uses the in-house checkout and the hand-off API is refused.
# Leave unset/true to let the config file + admin toggle decide.
# PURAMASS_CHECKOUT_ENABLED=false

# Shipping (Easyship)
# NOTE: These can also be configured in the admin Settings page (which takes
# precedence). Env vars act as defaults/fallbacks. If neither the admin
# setting nor EASYSHIP_API_KEY is set, checkout uses the flat rate below.
EASYSHIP_API_KEY=your_easyship_api_token_here
# Secret for verifying incoming Easyship tracking webhooks
# (endpoint: <base>/api/webhooks/easyship). If unset, webhooks are accepted
# unverified (test mode only).
EASYSHIP_WEBHOOK_SECRET=
# Optional override; defaults to the current public API base URL.
# EASYSHIP_API_URL=https://public-api.easyship.com
# Flat rate (CAD) charged when live rates are unavailable.
SHIP_FALLBACK_FLAT_RATE=20

# Origin / warehouse address that shipments are sent FROM.
SHIP_ORIGIN_LINE1=
SHIP_ORIGIN_CITY=
SHIP_ORIGIN_STATE=
SHIP_ORIGIN_POSTAL=
SHIP_ORIGIN_COUNTRY=CA
# Sender contact details — required by Easyship to CREATE a shipment/label.
SHIP_ORIGIN_COMPANY=
SHIP_ORIGIN_CONTACT_NAME=
SHIP_ORIGIN_CONTACT_EMAIL=
SHIP_ORIGIN_CONTACT_PHONE=

# Default parcel box (cm) and per-vial weight (kg) used to price the shipment.
SHIP_BOX_LENGTH_CM=20
SHIP_BOX_WIDTH_CM=15
SHIP_BOX_HEIGHT_CM=10
SHIP_ITEM_WEIGHT_KG=0.05
# Each Easyship item is sent with an HS code + description. The category slug
# below is mapped to its standard HS code (e.g. dry_food_supplements ->
# 17049000). Override the HS code or description directly if needed.
SHIP_ITEM_CATEGORY=dry_food_supplements
# SHIP_HS_CODE=17049000
SHIP_ITEM_DESCRIPTION=Supplements
